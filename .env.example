# ------------------------------------------------------------------
# Fish Nearby - environment variables
# Copy to .env.local for local dev, then fill in real values.
# NEVER commit a real .env / .env.local (see .gitignore).
# ------------------------------------------------------------------

# --- Supabase (Postgres/PostGIS + Auth) ---
# Public, browser-safe.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret. Server / ingest jobs only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Drizzle migrations).
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# --- OpenRouter (LLM normalization) ---
# Secret. Server / ingest jobs only.
OPENROUTER_API_KEY=

# --- MapLibre basemap tiles ---
# Public, but restrict to your domain at the provider.
NEXT_PUBLIC_MAPTILER_KEY=

# --- Location search / geocoding (todo 04) ---
# Public (domain-restricted) OR omit to use free Nominatim.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Optional: higher NY Socrata rate limits ---
# Public / low sensitivity. Omit if not needed.
NY_SOCRATA_APP_TOKEN=
